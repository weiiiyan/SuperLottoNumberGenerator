@startuml module-dependency
!theme plain
' 代码模块及其依赖图: 按整洁架构分层, 依赖只指向内层
' (app → adapters → application → domain)
' 渲染: 可用 VS Code PlantUML 插件, 或上传 kroki.io / plantuml.com 在线渲染

title SuperLottoNumberGenerator 模块依赖图（整洁架构分层）

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam dpi 150

legend top right
  ==图例==
  <size:10><i>虚线箭头 = 依赖 / 实现 / 调用方向</i></size>
  <size:10><i>依赖只指向内层: app → adapters → application → domain</i></size>
  <size:10><i>跨层数据载体: LottoTicket (值类型)</i></size>
endlegend

package "领域层 src/domain/ — lotto_core" as domain #FEF2E0 {
  component [LottoResult\n«值类型: 单组号码»] as LottoResult
  component [LottoTicket\n«实体: 5 组+时间+锁»] as LottoTicket
  component [LottoEngine\n«领域服务: 随机生成»] as LottoEngine

  LottoTicket ..> LottoResult : 包含 5 组
  LottoEngine ..> LottoResult : generate()
}

package "用例层 src/application/ — lotto_application" as application #F2E8F8 {
  component [LottoController\n«用例交互器: 唯一状态源»] as Controller
  interface "TicketRepository\n«用例层持久化接口 DIP 端口»" as TicketRepository

  Controller ..> TicketRepository : 依赖抽象, 不触碰具体仓储
  Controller ..> LottoEngine : 调用领域服务 generateBatch()
  Controller --> LottoTicket : 持有 m_ticket (唯一状态源)
}

package "适配器层 src/adapters/ — lotto_adapters" as adapters #E0F0E0 {
  component [QSettingsTicketRepository\n«QSettings INI 实现»] as QSettingsRepo

  QSettingsRepo ..|> TicketRepository : implements
  QSettingsRepo ..> LottoTicket : 展平/还原 号码与时间
}

package "视图层 src/app/ — lotto_app" as app #E0E8F8 {
  component [MainWindow\n«谦卑视图: 纯渲染»] as MainWindow
  component [style.qss\n«Qt 资源 :/style.qss»] as Style

  MainWindow --> Controller : 按钮 clicked 转发动作
  MainWindow ..> LottoTicket : ticketChanged 信号渲染
  MainWindow ..> Style : 加载 QSS
}

package "组合根 src/app/main.cpp\n— SuperLottoNumberGenerator 可执行目标" as exe #F8E8E8 {
  component [main()\n«装配具体依赖»] as Main
  component [QSettings\n(SuperLottoNumberGenerator.ini)] as QSettings

  Main ..> QSettingsRepo : new(具体类) 唯一接触点
  Main ..> Controller : new(&repository, &engine)
  Main ..> QSettings : new(路径, IniFormat)
}

package "测试 tests/" as tests #F0F0F0 {
  component [LottoEngineTest] as T1
  component [LottoControllerTest\n(注入内存 Fake 仓储, 无 GUI 依赖)] as T2
  component [QSettingsRepositoryTest\n(QTemporaryDir 隔离)] as T3
  component [MainWindowTest\n(offscreen 集成)] as T4

  T1 ..> LottoEngine
  T2 ..> Controller
  T2 ..> TicketRepository : 构造注入 Fake
  T3 ..> QSettingsRepo
  T4 ..> MainWindow
}

' ── 层间依赖: 编译目标链接关系 ──
application ..> domain : lotto_application → lotto_core (PUBLIC)
adapters ..> application : lotto_adapters → lotto_application (PUBLIC)
app ..> application : lotto_app → lotto_application (PUBLIC)
app ..> domain : lotto_app → lotto_core (PUBLIC)
exe ..> app : exe → lotto_app
exe ..> adapters : exe → lotto_adapters
exe ..> application : exe → lotto_application
exe ..> domain : exe → lotto_core
tests ..> domain : 测试 → lotto_core

@enduml
